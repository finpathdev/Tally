import { button, h, icon, openDialog, toast } from './dom.ts';

/**
 * "Install app" support across browsers:
 * - Chrome, Edge, Samsung Internet, Opera, Android: the native prompt, captured
 *   from `beforeinstallprompt` and fired from our own button.
 * - iPhone / iPad (any browser) and Safari on macOS: no prompt API exists, so
 *   the button opens short, platform-specific steps instead.
 * - Already installed (running standalone): the button is hidden.
 */

interface BeforeInstallPromptEvent extends Event {
  prompt(): Promise<void>;
  userChoice: Promise<{ outcome: 'accepted' | 'dismissed' }>;
}

type Platform = 'prompt' | 'ios' | 'mac-safari' | 'other';

let deferred: BeforeInstallPromptEvent | null = null;
/** Embedded previews (e.g. a hosted demo in an iframe) can't be installed. */
const EMBEDDED = import.meta.env.VITE_DEMO === '1' || window.self !== window.top;
const listeners = new Set<() => void>();
const notify = () => listeners.forEach((fn) => fn());

export function isStandalone(): boolean {
  return (
    window.matchMedia('(display-mode: standalone)').matches ||
    window.matchMedia('(display-mode: window-controls-overlay)').matches ||
    (navigator as Navigator & { standalone?: boolean }).standalone === true
  );
}

function platform(): Platform {
  if (deferred) return 'prompt';
  const ua = navigator.userAgent;
  const iOS = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
  if (iOS) return 'ios';
  const safari = /Safari\//.test(ua) && !/Chrome|Chromium|Edg|OPR|Firefox/.test(ua);
  if (/Macintosh/.test(ua) && safari) return 'mac-safari';
  return 'other';
}

/** Whether our Install button has something useful to do in this browser. */
export function canOfferInstall(): boolean {
  return !EMBEDDED && !isStandalone() && platform() !== 'other';
}

export function onInstallChange(fn: () => void): () => void {
  listeners.add(fn);
  return () => listeners.delete(fn);
}

export function initInstall() {
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault(); // keep the mini-infobar away; we show our own button
    deferred = e as BeforeInstallPromptEvent;
    notify();
  });
  window.addEventListener('appinstalled', () => {
    deferred = null;
    toast('Tally is installed. Open it from your home screen, dock or app list.');
    notify();
  });
  window.matchMedia('(display-mode: standalone)').addEventListener('change', notify);
}

export async function install() {
  const p = platform();
  if (p === 'prompt' && deferred) {
    const ev = deferred;
    deferred = null; // a prompt can only be used once
    await ev.prompt();
    const { outcome } = await ev.userChoice;
    if (outcome === 'dismissed') toast('No problem. The Install button stays in the Sync tab if you change your mind.');
    notify();
    return;
  }
  showInstructions(p);
}

function step(n: number, ...content: (Node | string)[]) {
  return h('li', null, h('span', { class: 'inst-n', 'aria-hidden': 'true' }, String(n)), h('span', null, ...content));
}

function shareGlyph() {
  // The iOS share icon: a box with an up arrow.
  return h('span', { class: 'inst-glyph', 'aria-label': 'Share' }, icon('upload', 15));
}

export function showInstructions(p: Platform = platform()) {
  const body = () => {
    if (p === 'ios') {
      return h(
        'div',
        { class: 'install-steps' },
        h('p', null, 'On iPhone and iPad, apps are added from the Share menu.'),
        h('ol', null,
          step(1, 'Tap ', shareGlyph(), ' Share. In Safari it’s in the toolbar; in Chrome it’s at the top right.'),
          step(2, 'Scroll down and tap ', h('strong', null, 'Add to Home Screen'), '.'),
          step(3, 'If you see ', h('strong', null, 'Open as Web App'), ', leave it on. Then tap ', h('strong', null, 'Add'), '.'),
        ),
        h('p', { class: 'hint' }, 'Tally then opens full screen from its own icon and works offline.'),
      );
    }
    if (p === 'mac-safari') {
      return h(
        'div',
        { class: 'install-steps' },
        h('ol', null,
          step(1, 'In the menu bar, choose ', h('strong', null, 'File → Add to Dock…'), '.'),
          step(2, 'Click ', h('strong', null, 'Add'), '.'),
        ),
        h('p', { class: 'hint' }, 'Tally then opens in its own window from the Dock and works offline.'),
      );
    }
    return h(
      'div',
      { class: 'install-steps' },
      h('p', null, 'This browser doesn’t offer to install web apps directly. You have two options:'),
      h('ol', null,
        step(1, 'Open Tally in ', h('strong', null, 'Chrome'), ', ', h('strong', null, 'Edge'), ' or ', h('strong', null, 'Safari'), ' and use the Install button there.'),
        step(2, 'Or bookmark this page. Everything still works offline once it has loaded.'),
      ),
      h('p', { class: 'hint' }, 'In Chrome or Edge you can also use the install icon at the right end of the address bar.'),
    );
  };
  openDialog({ title: 'Install Tally', body, submitLabel: 'Got it', onSubmit: () => {}, infoOnly: true });
}

/** A card for the Sync tab: always explains, even where the top-bar button is hidden. */
export function installCard(): HTMLElement {
  if (EMBEDDED) {
    return h('div', { class: 'card install-card' },
      h('div', { class: 'install-art', 'aria-hidden': 'true' }, icon('download', 28)),
      h('div', null, h('h3', null, 'Use Tally as an app'),
        h('p', { class: 'hint' }, 'This is an embedded preview, so it can’t be installed from here. Open the deployed site (for example, your GitHub Pages address) and use Install app there.')));
  }
  const standalone = isStandalone();
  return h(
    'div',
    { class: 'card install-card' },
    h('div', { class: 'install-art', 'aria-hidden': 'true' }, h('img', { src: `${import.meta.env.BASE_URL}icon-192.png`, alt: '', width: 56, height: 56 })),
    h(
      'div',
      null,
      h('h3', null, standalone ? 'You’re using the app' : 'Use Tally as an app'),
      h(
        'p',
        { class: 'hint' },
        standalone
          ? 'Tally is installed on this device. It opens from its own icon, works offline, and shows a badge for renewals due in the next 3 days.'
          : 'Install it to open Tally from your home screen or dock, use it offline, open bank CSVs with it, and see a badge when renewals are due.',
      ),
    ),
    standalone
      ? null
      : button(deferred ? 'Install' : 'How to install', () => void install(), { variant: 'primary', icon: 'download', key: 'install-card' }),
  );
}

import { svg } from './dom.ts';

export interface Ring {
  label: string;
  /** Relative weight (e.g. monthly cost). */
  weight: number;
  /** Lobes around the ring; encodes billing frequency. */
  lobes: number;
  tone: 'ink' | 'alert' | 'muted';
}

/**
 * A guilloché rosette, the engraved pattern printed on banknotes, drawn
 * from real data: one woven ring per subscription, from the cheapest inside
 * to the most expensive outside. A ring's swell shows its share of spending
 * and its lobe count shows how often it bills.
 */
export function rosette(rings: Ring[], size = 220): SVGElement {
  const c = 100;
  const root = svg('svg', {
    viewBox: '0 0 200 200',
    width: size,
    height: size,
    class: 'rosette',
    role: 'img',
    'aria-label': rings.length
      ? `Pattern of ${rings.length} subscriptions; larger swells cost more.`
      : 'Empty pattern: no subscriptions yet.',
  });

  // Base engraving so an empty state still looks intentional.
  root.appendChild(svg('circle', { cx: c, cy: c, r: 96, class: 'ros-frame' }));
  root.appendChild(svg('circle', { cx: c, cy: c, r: 12, class: 'ros-frame' }));

  const total = rings.reduce((a, r) => a + r.weight, 0) || 1;
  const sorted = [...rings].sort((a, b) => a.weight - b.weight);
  const inner = 20;
  const outer = 86;
  const step = sorted.length > 1 ? (outer - inner) / (sorted.length - 1) : 0;

  sorted.forEach((ring, i) => {
    const base = sorted.length > 1 ? inner + step * i : (inner + outer) / 2;
    const amp = 2 + 10 * Math.sqrt(ring.weight / total);
    const g = svg('g', { class: `ros-ring ros-${ring.tone}`, style: `--i:${i}` });
    const title = svg('title');
    title.textContent = ring.label;
    g.appendChild(title);
    // Three phase-shifted strands give the woven, engraved look.
    for (let strand = 0; strand < 3; strand++) {
      const phase = (strand * Math.PI * 2) / (3 * ring.lobes);
      let d = '';
      const N = 360;
      for (let k = 0; k <= N; k++) {
        const t = (k / N) * Math.PI * 2;
        const r = base + amp * Math.sin(ring.lobes * t + phase) + (amp / 3) * Math.sin(2 * ring.lobes * t);
        const x = c + r * Math.cos(t);
        const y = c + r * Math.sin(t);
        d += `${k ? 'L' : 'M'}${x.toFixed(2)} ${y.toFixed(2)}`;
      }
      g.appendChild(svg('path', { d: d + 'Z' }));
    }
    root.appendChild(g);
  });
  return root;
}

/* ==========================================================================
   Tally · "banknote print"
   Security-paper ground, intaglio ink, serial-number red for things that
   need attention. Gloock (engraved serif) for figures and titles,
   Hanken Grotesk for reading, Martian Mono for numbers.
   ========================================================================== */

:root {
  --paper: #e9eee8;
  --card: #f6f8f4;
  --card-2: #eef2ec;
  --ink: #1c2b45;
  --ink-2: #4b5b72;
  --ink-3: #5a6779;
  --line: #cbd4cc;
  --line-2: #dde4dc;
  --serial: #b2362a;
  --serial-bg: #f6e1dc;
  --seal: #2c6b58;
  --seal-bg: #dcebe3;
  --ochre: #83590d;
  --ochre-bg: #f2e7cf;
  --cat-0: #1c2b45;
  --cat-1: #2c6b58;
  --cat-2: #b2362a;
  --cat-3: #83590d;
  --cat-4: #6b5aa6;
  --cat-5: #5a6779;
  --shadow: 0 1px 0 rgb(28 43 69 / 0.04), 0 8px 24px -16px rgb(28 43 69 / 0.25);

  --f-display: 'Gloock', 'Iowan Old Style', Georgia, serif;
  --f-body: 'Hanken Grotesk Variable', 'Hanken Grotesk', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --f-mono: 'Martian Mono', ui-monospace, 'SF Mono', Menlo, monospace;

  --r: 10px;
  --gap: clamp(14px, 2vw, 22px);
  color-scheme: light;
}

:root[data-theme='dark'] {
  --paper: #0f1620;
  --card: #151f2b;
  --card-2: #1a2633;
  --ink: #dde6e0;
  --ink-2: #a3b1c0;
  --ink-3: #8a9aae;
  --line: #2a3747;
  --line-2: #223040;
  --serial: #ff6f5e;
  --serial-bg: #3a1f1e;
  --seal: #62c9a7;
  --seal-bg: #173229;
  --ochre: #e5b24c;
  --ochre-bg: #362a14;
  --cat-0: #dde6e0;
  --cat-1: #62c9a7;
  --cat-2: #ff6f5e;
  --cat-3: #e5b24c;
  --cat-4: #a597e6;
  --cat-5: #8a9aae;
  --shadow: 0 1px 0 rgb(0 0 0 / 0.2), 0 10px 30px -18px rgb(0 0 0 / 0.8);
  color-scheme: dark;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  -webkit-text-size-adjust: 100%;
}

body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font: 400 15px/1.5 var(--f-body);
  -webkit-font-smoothing: antialiased;
  min-height: 100dvh;
}

/* Faint security-paper fibres. */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.5;
  background:
    repeating-linear-gradient(115deg, transparent 0 22px, color-mix(in srgb, var(--ink) 3%, transparent) 22px 23px),
    repeating-linear-gradient(25deg, transparent 0 31px, color-mix(in srgb, var(--seal) 3%, transparent) 31px 32px);
  z-index: -1;
}

h1,
h2,
h3 {
  margin: 0;
  font-weight: 400;
}
p {
  margin: 0;
}
a {
  color: inherit;
}
code,
kbd {
  font-family: var(--f-mono);
  font-size: 0.82em;
  background: var(--card-2);
  border: 1px solid var(--line-2);
  padding: 0.05em 0.35em;
  border-radius: 4px;
}

:focus-visible {
  outline: 2px solid var(--serial);
  outline-offset: 2px;
  border-radius: 4px;
}

.sr-only {
  position: absolute !important;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}

.skip {
  position: absolute;
  left: 12px;
  top: -40px;
  background: var(--ink);
  color: var(--paper);
  padding: 8px 12px;
  border-radius: 6px;
  z-index: 50;
}
.skip:focus {
  top: 12px;
}

.num {
  font-family: var(--f-mono);
  font-size: 0.86em;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
}
.strong {
  font-weight: 600;
}
.muted {
  color: var(--ink-3);
}
.pos-text {
  color: var(--seal);
}
.neg-text,
.warn-text,
.svc-meta.warn-text {
  color: var(--serial);
}
.spacer {
  flex: 1;
}
.icon {
  flex: none;
}

/* ---------- top bar ---------- */

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 10px max(16px, calc((100vw - 1180px) / 2));
  background: color-mix(in srgb, var(--paper) 86%, transparent);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--line);
}

.brand {
  display: flex;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  font-family: var(--f-display);
  font-size: 1.55rem;
  letter-spacing: -0.01em;
}
.mark path {
  stroke: var(--ink);
  stroke-width: 2.6;
  stroke-linecap: round;
  fill: none;
  stroke-dasharray: 30;
  stroke-dashoffset: 30;
  animation: draw 0.35s ease-out forwards;
  animation-delay: calc(var(--d) * 0.09s);
}
.mark .gate {
  stroke: var(--serial);
}

.tabs {
  display: flex;
  gap: 2px;
  margin: 0 auto;
  padding: 3px;
  background: var(--card-2);
  border: 1px solid var(--line);
  border-radius: 999px;
}
.tab {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 7px 14px;
  border-radius: 999px;
  text-decoration: none;
  color: var(--ink-2);
  font-weight: 500;
  font-size: 0.92rem;
}
.tab:hover {
  color: var(--ink);
}
.tab[aria-current='page'] {
  background: var(--ink);
  color: var(--paper);
}

.top-actions {
  display: flex;
  gap: 2px;
}

/* ---------- layout ---------- */

main {
  max-width: 1180px;
  margin: 0 auto;
  padding: var(--gap) 16px 48px;
}
main:focus,
main:focus-visible {
  outline: none;
}
.view {
  display: grid;
  gap: var(--gap);
}
/* Grid children default to min-width: auto and would grow to fit wide
   content (charts, tables), widening the whole page on phones. */
.view > *,
.cal-stack > *,
.split-grid > * {
  min-width: 0;
}
.view.enter {
  animation: rise 0.25s ease-out;
}

.toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px 16px;
}
.section-title {
  font-family: var(--f-display);
  font-size: 1.9rem;
  line-height: 1.1;
}

.card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: var(--r);
  padding: 18px;
  box-shadow: var(--shadow);
}
.card h3 {
  font-family: var(--f-display);
  font-size: 1.2rem;
}
.card-head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px 12px;
  margin-bottom: 12px;
}
.card-head.pad {
  padding: 16px 18px 0;
}

.split-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--gap);
  align-items: start;
}

.row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
}
.row.wrap {
  flex-wrap: wrap;
}
.row.end {
  justify-content: flex-end;
}

.eyebrow {
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-3);
}
.hint {
  color: var(--ink-3);
  font-size: 0.88rem;
}
.lede {
  max-width: 62ch;
  color: var(--ink-2);
}

.banner {
  margin-bottom: var(--gap);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  border: 1px dashed var(--ink-3);
  border-radius: var(--r);
  color: var(--ink-2);
  font-size: 0.92rem;
}

/* ---------- buttons & inputs ---------- */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 38px;
  padding: 0 14px;
  border-radius: 8px;
  border: 1px solid var(--line);
  background: var(--card);
  color: var(--ink);
  font: 500 0.9rem/1 var(--f-body);
  cursor: pointer;
  text-decoration: none;
  white-space: nowrap;
  transition: background 0.12s, border-color 0.12s, transform 0.06s;
}
.btn:hover {
  border-color: var(--ink-3);
}
.btn:active {
  transform: translateY(1px);
}
.btn:disabled {
  opacity: 0.45;
  cursor: default;
}
.btn-primary {
  background: var(--ink);
  border-color: var(--ink);
  color: var(--paper);
}
.btn-primary:hover {
  background: color-mix(in srgb, var(--ink) 88%, var(--serial));
}
.btn-quiet {
  background: transparent;
  border-color: transparent;
  color: var(--ink-2);
}
.btn-quiet:hover {
  background: var(--card-2);
  border-color: transparent;
  color: var(--ink);
}
.btn-danger {
  color: var(--serial);
  border-color: color-mix(in srgb, var(--serial) 40%, var(--line));
  background: transparent;
}
.btn-danger:hover {
  background: var(--serial-bg);
  border-color: var(--serial);
}
.btn-sm {
  min-height: 30px;
  padding: 0 10px;
  font-size: 0.84rem;
}
.btn-icon {
  width: 38px;
  padding: 0;
}
.btn-icon.btn-sm {
  width: 30px;
}

input,
select,
textarea {
  font: inherit;
  color: var(--ink);
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 8px;
  min-height: 38px;
  padding: 0 10px;
  width: 100%;
}
input[type='checkbox'] {
  width: 17px;
  height: 17px;
  min-height: 0;
  accent-color: var(--ink);
  margin: 0;
  flex: none;
}
input:focus-visible,
select:focus-visible {
  outline: 2px solid var(--serial);
  outline-offset: 0;
  border-color: transparent;
}

.field {
  display: grid;
  gap: 5px;
}
.field-label {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--ink-2);
}
.field-hint {
  font-size: 0.78rem;
  color: var(--ink-3);
}
.field.inline {
  grid-template-columns: 1fr 120px;
  align-items: center;
}
.inline-field {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.85rem;
  color: var(--ink-2);
}
.inline-field input,
.inline-field select {
  width: auto;
  min-height: 34px;
}
.check {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.9rem;
  cursor: pointer;
}

.grid-form {
  display: grid;
  gap: 14px;
}
.grid-form.cols-4 {
  grid-template-columns: repeat(4, 1fr);
}
.pair {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.pair.align-end {
  align-items: end;
}
[hidden] {
  display: none !important;
}

.segmented {
  display: inline-flex;
  padding: 3px;
  gap: 2px;
  background: var(--card-2);
  border: 1px solid var(--line);
  border-radius: 9px;
}
.segmented button {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 0;
  background: transparent;
  color: var(--ink-2);
  font: 500 0.85rem var(--f-body);
  padding: 6px 11px;
  border-radius: 6px;
  cursor: pointer;
}
.segmented button.on {
  background: var(--card);
  color: var(--ink);
  box-shadow: 0 1px 2px rgb(0 0 0 / 0.1);
}

/* ---------- the note (signature) ---------- */

.note {
  position: relative;
  display: grid;
  grid-template-columns: auto 1fr minmax(220px, 280px);
  gap: clamp(16px, 3vw, 36px);
  align-items: center;
  padding: clamp(18px, 3vw, 30px);
  background:
    radial-gradient(circle at 12% 50%, color-mix(in srgb, var(--seal) 10%, transparent), transparent 55%),
    var(--card);
  border: 1px solid var(--line);
  border-radius: 14px;
  box-shadow: var(--shadow);
  overflow: hidden;
}
/* Engraved double frame, like the border of a note. */
.note::after {
  content: '';
  position: absolute;
  inset: 7px;
  border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
  border-radius: 9px;
  pointer-events: none;
}

.rosette {
  display: block;
  width: clamp(150px, 20vw, 220px);
  height: auto;
}
.ros-frame {
  fill: none;
  stroke: color-mix(in srgb, var(--ink) 25%, transparent);
  stroke-width: 0.5;
  stroke-dasharray: 1 2;
}
.ros-ring path {
  fill: none;
  stroke-width: 0.55;
  stroke-dasharray: 900;
  stroke-dashoffset: 900;
  animation: draw 1.4s cubic-bezier(0.3, 0.6, 0.2, 1) forwards;
  animation-delay: calc(var(--i) * 0.08s);
}
.ros-ink path {
  stroke: color-mix(in srgb, var(--ink) 72%, transparent);
}
.ros-alert path {
  stroke: var(--serial);
}
.ros-muted path {
  stroke: color-mix(in srgb, var(--ink) 22%, transparent);
  stroke-dasharray: 1.5 2;
  stroke-dashoffset: 0;
  animation: none;
}
.ros-ring:hover path {
  stroke-width: 1.2;
}
/* Only animate the first paint; later re-renders appear instantly. */
.settled-anim .ros-ring path,
.settled-anim .mark path {
  animation: none;
  stroke-dashoffset: 0;
}

.serial {
  font-family: var(--f-mono);
  font-size: 0.72rem;
  color: var(--serial);
  letter-spacing: 0.08em;
  margin-bottom: 14px;
}
.figure {
  font-family: var(--f-display);
  font-size: clamp(2.6rem, 6vw, 4.2rem);
  line-height: 1;
  letter-spacing: -0.02em;
  margin: 4px 0 8px;
  font-variant-numeric: tabular-nums;
}
.figure.sm {
  font-size: clamp(2rem, 4.5vw, 3rem);
}
.figure .per {
  font-family: var(--f-body);
  font-size: 1rem;
  color: var(--ink-3);
  margin-left: 6px;
  letter-spacing: 0;
}
.note-sub {
  color: var(--ink-2);
}
.note-main .hint {
  margin-top: 12px;
}
.whatif-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px;
  margin-top: 12px;
  padding: 8px 10px;
  border-radius: 8px;
  background: var(--seal-bg);
  color: var(--seal);
  font-size: 0.92rem;
}
.note-side {
  align-self: stretch;
  border-left: 1px dashed var(--line);
  padding-left: clamp(14px, 2vw, 24px);
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.soon {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 8px;
}
.soon li {
  display: grid;
  grid-template-columns: 76px 1fr auto;
  gap: 8px;
  align-items: baseline;
  font-size: 0.9rem;
}
.soon-day {
  color: var(--serial);
  font-size: 0.78rem;
  font-weight: 600;
}
.soon-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.soon-total {
  margin-top: auto;
  padding-top: 8px;
  border-top: 1px solid var(--line-2);
  display: flex;
  justify-content: space-between;
  font-size: 0.9rem;
  color: var(--ink-2);
}

/* ---------- tables ---------- */

.table-wrap {
  padding: 0;
  overflow: hidden;
}
.table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.92rem;
}
.table th {
  text-align: left;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-3);
  padding: 12px 14px;
  border-bottom: 1px solid var(--line);
}
.table td {
  padding: 12px 14px;
  border-bottom: 1px solid var(--line-2);
  vertical-align: top;
}
.table tr:last-child td {
  border-bottom: 0;
}
.table .r {
  text-align: right;
}
.table td > .svc-meta,
.table td > .num + .svc-meta {
  display: block;
}
.svc {
  display: grid;
  gap: 2px;
}
.svc-name {
  font-weight: 600;
}
.svc-meta {
  font-size: 0.8rem;
  color: var(--ink-3);
  display: inline-flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
}
.table td.r .svc-meta {
  justify-content: flex-end;
}
.actions {
  white-space: nowrap;
}
.is-paused td {
  color: var(--ink-3);
}
.is-paused .svc-name {
  text-decoration: line-through;
  text-decoration-color: var(--ink-3);
}
.is-whatif {
  background: repeating-linear-gradient(135deg, transparent 0 8px, color-mix(in srgb, var(--serial) 6%, transparent) 8px 9px);
}
.is-whatif .svc-name {
  text-decoration: line-through;
  text-decoration-color: var(--serial);
}

.tag {
  font-size: 0.72rem;
  padding: 1px 7px;
  border-radius: 999px;
  border: 1px solid var(--line);
  color: var(--ink-2);
}
.tag-trial {
  border-color: var(--ochre);
  color: var(--ochre);
}
.flags {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-bottom: 6px;
}
.flag {
  font-size: 0.74rem;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 4px;
}
.flag.sev-3 {
  background: var(--serial-bg);
  color: var(--serial);
}
.flag.sev-2 {
  background: var(--ochre-bg);
  color: var(--ochre);
}
.flag.sev-1 {
  background: var(--card-2);
  color: var(--ink-2);
  border: 1px solid var(--line);
}
.whatif {
  display: flex;
  width: fit-content;
  margin-top: 4px;
  align-items: center;
  gap: 6px;
  font-size: 0.8rem;
  color: var(--ink-2);
  cursor: pointer;
}
.whatif input {
  width: 15px;
  height: 15px;
  accent-color: var(--serial);
}

/* ---------- list tools ---------- */

.list-tools {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px 16px;
  padding: 12px 14px;
  border-bottom: 1px solid var(--line);
}
.card:not(.table-wrap) > .list-tools {
  margin: -18px -18px 0;
}
.search {
  position: relative;
  flex: 1 1 220px;
  max-width: 340px;
  display: flex;
  align-items: center;
}
.search .icon {
  position: absolute;
  left: 10px;
  color: var(--ink-3);
  pointer-events: none;
}
.search input {
  padding-left: 32px;
}

/* ---------- forecast ---------- */

.cal-stack {
  display: grid;
  gap: var(--gap);
}
.forecast-card .card-head {
  align-items: flex-start;
}
.forecast-card .card-head > div {
  flex: 1 1 260px;
}
.forecast-card .hint {
  max-width: 60ch;
  margin-top: 2px;
}
.chart-scroll {
  overflow-x: auto;
}
.forecast {
  display: block;
  width: 100%;
  min-width: 520px;
  height: auto;
}
.fc-bar {
  fill: color-mix(in srgb, var(--ink) 78%, transparent);
}
.fc-bar.now {
  fill: var(--ink);
}
.fc-bar.peak {
  fill: var(--serial);
}
.fc-bar:hover {
  fill: var(--seal);
}
.fc-avg {
  stroke: var(--ink-3);
  stroke-width: 1;
  stroke-dasharray: 4 4;
}
.fc-label {
  fill: var(--ink-3);
  font: 500 11px var(--f-body);
}
.fc-value {
  fill: var(--ink);
  font: 500 11px var(--f-mono);
}

/* ---------- category bar ---------- */

.cats {
  display: grid;
  gap: 12px;
}
.stack {
  display: flex;
  height: 12px;
  border-radius: 999px;
  overflow: hidden;
  gap: 2px;
}
.seg {
  min-width: 4px;
}
.legend {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8px 20px;
  font-size: 0.88rem;
}
.legend li {
  display: flex;
  align-items: center;
  gap: 7px;
}
.dot {
  width: 9px;
  height: 9px;
  border-radius: 2px;
}
.c0 { background: var(--cat-0); }
.c1 { background: var(--cat-1); }
.c2 { background: var(--cat-2); }
.c3 { background: var(--cat-3); }
.c4 { background: var(--cat-4); }
.c5 { background: var(--cat-5); }

/* ---------- calendar ---------- */

.cal-head {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 12px;
}
.cal-head h3 {
  min-width: 170px;
  text-align: center;
}
.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 4px;
}
.cal-dow {
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-3);
  padding: 4px 6px;
}
.cal-cell {
  min-height: 92px;
  padding: 6px;
  border: 1px solid var(--line-2);
  border-radius: 6px;
  display: flex;
  flex-direction: column;
  gap: 3px;
  overflow: hidden;
}
.cal-cell.out {
  opacity: 0.4;
}
.cal-cell.today {
  border-color: var(--serial);
  box-shadow: inset 0 0 0 1px var(--serial);
}
.cal-date {
  font-family: var(--f-mono);
  font-size: 0.75rem;
  color: var(--ink-2);
}
.cal-chip {
  font-size: 0.74rem;
  padding: 1px 6px;
  border-radius: 4px;
  background: var(--ink);
  color: var(--paper);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- import ---------- */

.import {
  display: grid;
  gap: 16px;
}
.dropzone {
  display: grid;
  justify-items: center;
  gap: 4px;
  padding: 28px;
  border: 1.5px dashed var(--ink-3);
  border-radius: var(--r);
  text-align: center;
  cursor: pointer;
  transition: background 0.15s;
}
.dropzone:hover,
.dropzone.over {
  background: var(--card-2);
  border-color: var(--ink);
}
.dropzone:focus-within {
  outline: 2px solid var(--serial);
}
.meter {
  display: inline-block;
  width: 44px;
  height: 5px;
  margin-right: 8px;
  vertical-align: middle;
  border-radius: 99px;
  background: linear-gradient(90deg, var(--seal) calc(var(--v) * 100%), var(--line) 0);
}

.empty {
  display: grid;
  justify-items: start;
  gap: 6px;
  padding: 28px;
  color: var(--ink-2);
}
.empty-title {
  font-family: var(--f-display);
  font-size: 1.25rem;
  color: var(--ink);
}

/* ---------- split ---------- */

.balances {
  list-style: none;
  padding: 0;
  margin: 0 0 16px;
  display: grid;
  gap: 12px;
}
.balances li {
  display: grid;
  grid-template-columns: minmax(96px, 150px) 1fr 104px;
  grid-template-areas: 'who bar num' 'who meta meta';
  align-items: center;
  column-gap: 12px;
}
.person {
  grid-area: who;
  display: flex;
  align-items: center;
  gap: 8px;
  border: 0;
  background: none;
  padding: 0;
  font: inherit;
  color: inherit;
  cursor: pointer;
  text-align: left;
}
.person:hover .person-name {
  text-decoration: underline;
}
.avatar {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  border: 1px solid var(--ink);
  font-family: var(--f-display);
  font-size: 0.95rem;
  flex: none;
}
.person-name {
  font-weight: 600;
}
.person-meta {
  grid-area: meta;
}
.bal-bar {
  grid-area: bar;
  position: relative;
  height: 10px;
  background: var(--card-2);
  border-radius: 99px;
}
.bal-bar::before {
  content: '';
  position: absolute;
  left: 50%;
  top: -3px;
  bottom: -3px;
  width: 1px;
  background: var(--ink-3);
}
.bal-fill {
  position: absolute;
  top: 0;
  bottom: 0;
  border-radius: 99px;
}
.bal-fill.pos {
  left: 50%;
  background: var(--seal);
}
.bal-fill.neg {
  right: 50%;
  background: var(--serial);
}
.bal-num {
  grid-area: num;
  text-align: right;
}
.add-member {
  display: grid;
  grid-template-columns: 1fr 1.2fr auto;
  gap: 8px;
  padding-top: 14px;
  border-top: 1px solid var(--line-2);
}
.transfers {
  list-style: none;
  padding: 0;
  margin: 0 0 12px;
  display: grid;
  gap: 8px;
}
.transfers li {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  border: 1px solid var(--line-2);
  border-radius: 8px;
  background: var(--card-2);
}
.transfers .amount {
  margin-left: auto;
  font-size: 1rem;
}
.settled {
  display: grid;
  justify-items: center;
  gap: 6px;
  padding: 20px;
  color: var(--seal);
}
.payment-row td {

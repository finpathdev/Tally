                  h('span', { class: 'num qty', 'aria-label': `Quantity ${it.qty}` }, String(it.qty)),
                  button('', () => setItem(it.id, null, (x) => { x.qty += 1; }), { icon: 'plus', title: `One more ${it.name}`, variant: 'quiet', small: true, key: `inc-${it.id}` }),

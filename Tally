  gap: 10px;
  align-items: baseline;
}
.inst-n {
  display: grid;
  place-items: center;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 1px solid var(--ink);
  font-family: var(--f-display);
  font-size: 0.85rem;
}
.inst-glyph {
  display: inline-grid;
  place-items: center;
  width: 24px;
  height: 22px;

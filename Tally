  return h(
    'section',
    { class: 'view', 'aria-labelledby': 'sync-title' },
    h(
      'div',
      { class: 'toolbar' },
      h('h2', { id: 'sync-title', class: 'section-title' }, 'Sync & alerts'),
      h('p', { class: 'muted' }, 'Keep your subscriptions in a GitHub repo and get an issue, and an email, before anything renews.'),
    ),
    installCard(),
    h(
      'ol',
      { class: 'steps' },
      h(
        'li',
        { class: 'card step' },

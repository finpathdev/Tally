/* Installed app: respect the notch and home indicator. */
@media (display-mode: standalone) {
  .topbar {
    padding-top: max(10px, env(safe-area-inset-top));
  }
}

/* ---------- dialog ---------- */

.dialog {
  width: min(560px, calc(100vw - 24px));
  max-height: calc(100dvh - 24px);
  padding: 0;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--card);
  color: var(--ink);
  box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.45);
}
.dialog::backdrop {
  background: rgb(15 22 32 / 0.45);
  backdrop-filter: blur(2px);
}
.dialog[open] {
  animation: rise 0.18s ease-out;
}
.dialog-form {
  display: flex;
  flex-direction: column;
  max-height: calc(100dvh - 26px);
}
.dialog-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 18px 8px;
}
.dialog-head h2 {
  font-family: var(--f-display);
  font-size: 1.4rem;
}
.dialog-body {
  padding: 8px 18px 16px;
  overflow: auto;
}
.dialog-foot {
  display: flex;
  gap: 8px;
  padding: 12px 18px;
  border-top: 1px solid var(--line-2);
  background: var(--card-2);
  border-radius: 0 0 14px 14px;
}
.form-error {
  color: var(--serial);
  font-size: 0.88rem;
  padding: 0 18px;
}
.form-error:empty {
  display: none;
}
.shortcuts {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 10px 18px;
  margin: 0;
}
.shortcuts dd {
  margin: 0;
}

/* ---------- toasts ---------- */

.toasts {
  position: fixed;
  left: 50%;
  bottom: 20px;
  transform: translateX(-50%);
  display: grid;
  gap: 8px;
  z-index: 60;
  width: max-content;
  max-width: calc(100vw - 24px);
}
.toast {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 8px 8px 14px;
  border-radius: 10px;
  background: var(--ink);
  color: var(--paper);
  font-size: 0.9rem;
  box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.5);
  animation: rise 0.18s ease-out;
}
.toast .btn-quiet {
  color: var(--paper);
  text-decoration: underline;
  text-underline-offset: 3px;
}
.toast .btn-quiet:hover {
  background: color-mix(in srgb, var(--paper) 14%, transparent);
  color: var(--paper);
}
.toast.leaving {
  opacity: 0;
  transition: opacity 0.18s;
}

.foot {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 16px 32px;
  color: var(--ink-3);
  font-size: 0.82rem;
}

/* ---------- motion ---------- */

@keyframes draw {
  to {
    stroke-dashoffset: 0;
  }
}
@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(4px);
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation: none !important;
    transition: none !important;
  }
  .ros-ring path,
  .mark path {
    stroke-dashoffset: 0;
  }
}

/* ---------- responsive ---------- */


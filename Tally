  );

  function remove(id: string, name: string) {
    store.update(`Remove ${name}`, (d) => { d.cart.items = d.cart.items.filter((x) => x.id !== id); });
    toast(`Removed ${name}`, { label: 'Undo', run: () => store.undo() });

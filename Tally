      'div',
      { class: 'card table-wrap' },
      tools,
      h(
        'table',
        { class: 'table subs-table' },
        h(
          'thead',
          null,
          h('tr', null,
            h('th', { scope: 'col' }, 'Service'),
            h('th', { scope: 'col', class: 'r' }, 'Price'),
            h('th', { scope: 'col' }, 'Next charge'),
            h('th', { scope: 'col' }, 'Use'),
            h('th', { scope: 'col' }, 'Review'),

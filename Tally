        s.cart.items.push({ id: uid(), name, unitPrice: price, qty, taxable: d.get('taxable') === 'on', inBasket: false });
      });
      requestAnimationFrame(() => document.querySelector<HTMLInputElement>('.quick-add input[name=name]')?.focus());
    });
    return form;
  }
}


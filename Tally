/* ---------- sync ---------- */

.steps {
  list-style: none;
  counter-reset: step;
  margin: 0;
  padding: 0;
  display: grid;
  gap: var(--gap);
}
.step {
  counter-increment: step;
  position: relative;
  padding-left: 64px;
  display: grid;
  gap: 12px;
  justify-items: start;
}
.step > * {
  max-width: 100%;
}
.step .grid-form,
.step .field {
  width: 100%;
}
.step::before {
  content: counter(step);
  position: absolute;
  left: 18px;
  top: 16px;
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  border: 1px solid var(--ink);
  font-family: var(--f-display);
  font-size: 1rem;
}
.issue-preview {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 6px;
  font-size: 0.9rem;
}
.issue-preview li {
  display: flex;
  gap: 8px;
  align-items: center;
  padding: 8px 10px;
  border: 1px solid var(--line-2);

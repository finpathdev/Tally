    return localStorage.getItem('tally:banner') === 'off' || localStorage.getItem('tally:sample') !== '1';
  } catch {
    return store.loadedFrom !== 'demo';
  }
})();

function sampleBanner(): HTMLElement | null {
  if (bannerDismissed) return null;
  const dismiss = () => {
